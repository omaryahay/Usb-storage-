@echo off
chcp 65001 >nul
title USB Storage Guard - عمر يحي سيلان
setlocal
net session >nul 2>&1
if %errorlevel% neq 0 (
    echo يلزم تشغيل البرنامج بصلاحيات المسؤول...
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)
set "PSFILE=%LOCALAPPDATA%\USBStorageGuard\USBStorageGuard_Runtime.ps1"
if not exist "%LOCALAPPDATA%\USBStorageGuard" mkdir "%LOCALAPPDATA%\USBStorageGuard"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$; [IO.File]::WriteAllBytes('%PSFILE%',[Convert]::FromBase64String($b))"
if not exist "%PSFILE%" (
    echo تعذر تجهيز ملف التشغيل المؤقت.
    pause
    exit /b 1
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%PSFILE%"
echo.
echo انتهت المراقبة.
pause
endlocal
